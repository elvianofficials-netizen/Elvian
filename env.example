# Copy this file to ".env" and fill it in. Do NOT put real secrets in .env.example (it is safe to upload).
# Make the code hash with:   node server.js --hash "your secret code"
UNLOCK_CODE_HASH=
ALLOWED_ORIGIN=https://yourname.github.io
LLM_URL=
LLM_KEY=
LLM_MODEL=auto
PORT=8787
CHAT_LIMIT=50

# Google sign-in + chat sync
GOOGLE_CLIENT_ID=
SESSION_SECRET=   # make with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=         # same command; back it up
COOLDOWN_HOURS=6
REFILL_PROMPTS=15
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
